<%- include("partials/header.ejs") %>
<%- include("partials/navbar.ejs") %>

<div class="container mt-5">

    <!-- Welcome -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">
            Welcome, Admin 👋
        </h1>

        <p class="text-muted">
            Manage student records from one place.
        </p>
    </div>

    <!-- Dashboard Cards -->
    <div class="row g-4">

        <div class="col-md-4">

            <div class="card shadow border-0 text-center">

                <div class="card-body">

                    <i class="bi bi-people-fill text-primary fs-1"></i>

                    <h5 class="mt-3">
                        Total Students
                    </h5>

                    <h2>0</h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0 text-center">

                <div class="card-body">

                    <i class="bi bi-database-fill text-success fs-1"></i>

                    <h5 class="mt-3">
                        Database
                    </h5>

                    <h2 class="text-success">
                        Connected
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0 text-center">

                <div class="card-body">

                    <i class="bi bi-check-circle-fill text-warning fs-1"></i>

                    <h5 class="mt-3">
                        Status
                    </h5>

                    <h2 class="text-warning">
                        Active
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- Buttons -->

    <div class="text-center mt-5">

        <a href="/students" class="btn btn-primary btn-lg me-3">
            <i class="bi bi-people-fill"></i>
            View Students
        </a>

        <a href="/students/add" class="btn btn-success btn-lg">
            <i class="bi bi-person-plus-fill"></i>
            Add Student
        </a>

    </div>

</div>

<%- include("partials/footer.ejs") %>