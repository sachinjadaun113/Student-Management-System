<%- include("../partials/header.ejs") %>
<%- include("../partials/navbar.ejs") %>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-success text-white py-3">

                    <h3 class="mb-0">
                        <i class="bi bi-person-plus-fill"></i>
                        Add New Student
                    </h3>

                </div>

                <div class="card-body p-4">

                    <form action="/students/add" method="POST">

                        <div class="row">

                            <!-- Name -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold">
                                    Full Name
                                </label>

                                <input
                                    type="text"
                                    name="name"
                                    class="form-control"
                                    placeholder="Enter Full Name"
                                    required>

                            </div>

                            <!-- Roll No. -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold">
                                    Roll No
                                </label>

                               <input
                                type="text"
                                class="form-control"
                                name="rollNumber"
                                required>

                            </div>



                            <!-- Email -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold">
                                    Email
                                </label>

                                <input
                                    type="email"
                                    name="email"
                                    class="form-control"
                                    placeholder="Enter Email"
                                    required>

                            </div>

                            <!-- Phone -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold">
                                    Phone Number
                                </label>

                                <input
                                    type="text"
                                    name="phone"
                                    class="form-control"
                                    placeholder="Enter Phone Number"
                                    required>

                            </div>

                            <!-- Age -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold">
                                    Age
                                </label>

                                <input
                                    type="number"
                                    name="age"
                                    class="form-control"
                                    placeholder="Enter Age"
                                    required>

                            </div>

                            <!-- Branch -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold">
                                    Branch
                                </label>

                               <input
                                type="text"
                                class="form-control"
                                name="studentClass"
                                placeholder="Example: CSE"
                                required>

                            </div>

                             <!-- Section -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold">
                                    Section
                                </label>

                               <input
                                type="text"
                                class="form-control"
                                name="section"
                                placeholder="A"
                                required>

                            </div>


                            <!-- Course -->


                            <div class="col-12 mb-4">

                                <label class="form-label fw-semibold">
                                    Course
                                </label>

                                <select class="form-select" name="course" required>

                                    <option value="">Select Course</option>

                                    <% courses.forEach(course => { %>

                                        <option value="<%= course.courseName %>">

                                            <%= course.courseName %>

                                        </option>

                                    <% }) %>

                                </select>

                            </div>

                            <!-- Addmission Date -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold">
                                    Admission Date
                                </label>

                               <input
                                type="date"
                                class="form-control"
                                name="admissionDate"
                                required>

                            </div>

                             <!-- Academic Year -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold">
                                    Academic Year
                                </label>

                               <input
                                type="text"
                                class="form-control"
                                name="academicYear"
                                placeholder="2025-2026"
                                required>
                            </div>

                            <!-- Parent Name -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold">
                                    Parent Name
                                </label>

                               <input
                                type="text"
                                class="form-control"
                                name="parentName"
                                placeholder="Parent Name"
                                required>
                            </div>

                            <!-- Parent Phone -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold">
                                    Parent Phone
                                </label>

                               <input
                                type="text"
                                class="form-control"
                                name="parentPhone"
                                placeholder="+91"
                                required>
                            </div>



                        </div>

                        <div class="d-flex justify-content-between">

                            <a href="/students" class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>

                                Back

                            </a>

                            <button class="btn btn-success">

                                <i class="bi bi-check-circle"></i>

                                Save Student

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include("../partials/footer.ejs") %>