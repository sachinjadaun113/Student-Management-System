<%- include("../partials/header.ejs") %>
<%- include("../partials/navbar.ejs") %>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                Mark Daily Attendance

            </h2>

            <p class="text-muted">

                Mark attendance for all students.

            </p>

        </div>

        <a href="/attendance" class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>

            Attendance History

        </a>

    </div>

    <div class="card shadow border-0 mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <label class="form-label fw-semibold">

                        Attendance Date

                    </label>

                    <input
                        type="date"
                        class="form-control"
                        id="attendanceDate"
                        value="<%= new Date().toISOString().split('T')[0] %>">

                </div>

                <div class="col-md-8">

    <label class="form-label fw-semibold">

        Search Student

    </label>

    <div class="input-group">

        <select
            id="searchFilter"
            class="form-select"
            style="max-width:180px;">

            <option value="0">Roll No.</option>
            <option value="1">Name</option>
            <option value="2">Course</option>
            <option value="3">Class</option>
            <option value="4">Year</option>
            <option value="5">Section</option>

        </select>

             <input
                type="text"
                id="searchStudent"
                class="form-control"
                 placeholder="Search...">

             <span class="input-group-text">

              <i class="bi bi-search"></i>

           </span>

         </div>

    </div>

            </div>

        </div>

    </div>

    <form action="/attendance/mark" method="POST">

        <input
            type="hidden"
            id="hiddenDate"
            name="date"
            value="<%= new Date().toISOString().split('T')[0] %>">

        <div class="card shadow border-0">

            <div class="card-body table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>Roll No.</th>
                            <th>Name</th>
                            <th>Course</th>
                            <th>Class</th>
                            <th>Year</th>
                            <th>Section</th>
                            <th width="250">Attendance</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% students.forEach(student => { %>

                        <tr>

                            <td>

                                <%= student.rollNumber %>

                            </td>

                            <td>

                                <%= student.name %>

                            </td>

                            <td>

                                <%= student.course %>

                            </td>

                            <td>

                                <%= student.studentClass %>

                            </td>

                            <td><%= student.academicYear %></td>

                            <td><%= student.section %></td>

                            <td>

                                <input
                                    type="hidden"
                                    name="student"
                                    value="<%= student._id %>">

                                <div class="form-check form-check-inline">

                                    <input
                                        class="form-check-input"
                                        type="radio"
                                        name="status_<%= student._id %>"
                                        value="Present"
                                        checked>

                                    <label class="form-check-label">

                                        Present

                                    </label>

                                </div>

                                <div class="form-check form-check-inline">

                                    <input
                                        class="form-check-input"
                                        type="radio"
                                        name="status_<%= student._id %>"
                                        value="Absent">

                                    <label class="form-check-label">

                                        Absent

                                    </label>

                                </div>

                            </td>

                        </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

        <div class="text-end mt-4">

            <button class="btn btn-success btn-lg">

                <i class="bi bi-check-circle-fill"></i>

                Save Attendance

            </button>

        </div>

    </form>

</div>

<script>

const searchInput = document.getElementById("searchStudent");
const searchFilter = document.getElementById("searchFilter");

searchInput.addEventListener("keyup", searchTable);
searchFilter.addEventListener("change", searchTable);

function searchTable() {

    const value = searchInput.value.trim().toLowerCase();

    const column = Number(searchFilter.value);

    const rows = document.querySelectorAll("tbody tr");

    rows.forEach(row => {

        const cell = row.cells[column].innerText.toLowerCase();

        if (cell.includes(value)) {

            row.style.display = "";

        }

        else {

            row.style.display = "none";

        }

    });

}

document.getElementById("attendanceDate").addEventListener("change", function () {

    document.getElementById("hiddenDate").value = this.value;

});

</script>

<%- include("../partials/footer.ejs") %>