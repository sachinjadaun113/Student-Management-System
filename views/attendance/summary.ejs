<%- include("../partials/header.ejs") %>
<%- include("../partials/navbar.ejs") %>

<div class="container mt-5">

    <!-- Page Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                Attendance Summary

            </h2>

            <p class="text-muted">

                View attendance summary of all students.

            </p>

        </div>

        <a href="/attendance" class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>

            Attendance History

        </a>

    </div>

    <!-- Filters -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-3">

                    <label class="form-label fw-semibold">

                        From

                    </label>

                    <input
                        type="date"
                        id="fromDate"
                        class="form-control">

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-semibold">

                        To

                    </label>

                    <input
                        type="date"
                        id="toDate"
                        class="form-control">

                </div>

                <div class="col-md-6">

                    <label class="form-label fw-semibold">

                        Search Student

                    </label>

                    <div class="input-group">

                        <select
                            id="searchFilter"
                            class="form-select"
                            style="max-width:180px;">

                            <option value="0">Roll No.</option>
                            <option value="1">Name</option>
                            <option value="2">Course</option>
                            <option value="3">Class</option>
                            <option value="4">Year</option>
                            <option value="5">Section</option>

                        </select>

                        <input
                            type="text"
                            id="searchStudent"
                            class="form-control"
                            placeholder="Search...">

                        <span class="input-group-text">

                            <i class="bi bi-search"></i>

                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

