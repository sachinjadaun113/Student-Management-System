    <!-- Summary Table -->

    <div class="card shadow border-0">

        <div class="card-body table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>Roll No.</th>
                        <th>Name</th>
                        <th>Course</th>
                        <th>Class</th>
                        <th>Year</th>
                        <th>Section</th>
                        <th>Present</th>
                        <th>Absent</th>
                        <!-- <th>Total</th> -->
                        <th>Attendance %</th>
                        <th width="120">View</th>

                    </tr>

                </thead>

                <tbody>

                    <% summary.forEach(item=>{ %>

                        <tr>

                            <td><%= item.student.rollNumber %></td>

                            <td><%= item.student.name %></td>

                            <td><%= item.student.course %></td>

                            <td><%= item.student.studentClass %></td>

                            <td><%= item.student.academicYear %></td>

                            <td><%= item.student.section %></td>

                            <td>

                                <span class="badge bg-success">

                                    <%= item.present %>

                                </span>

                            </td>

                            <td>

                                <span class="badge bg-danger">

                                    <%= item.absent %>

                                </span>

                            </td>

                            <!-- <td>

                                <%= item.total %>

                            </td> -->

                            <td>

                                <span class="badge bg-primary">

                                    <%= item.percentage %>%

                                </span>

                            </td>

                            <td>

                                <a
                                    href="/attendance/summary/<%= item.student._id %>"
                                    class="btn btn-info btn-sm">

                                    <i class="bi bi-eye-fill"></i>

                                    View

                                </a>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</div>

<script>

const searchInput=document.getElementById("searchStudent");

const searchFilter=document.getElementById("searchFilter");

searchInput.addEventListener("keyup",searchTable);

searchFilter.addEventListener("change",searchTable);

function searchTable(){

    const value=searchInput.value.trim().toLowerCase();

    const column=Number(searchFilter.value);

    document.querySelectorAll("tbody tr").forEach(row=>{

        const text=row.cells[column].innerText.toLowerCase();

        row.style.display=text.includes(value)?"":"none";

    });

}

</script>

<%- include("../partials/footer.ejs") %>