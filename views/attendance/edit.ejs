<%- include("../partials/header.ejs") %>
<%- include("../partials/navbar.ejs") %>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-warning text-dark py-3">

                    <h3 class="mb-0">

                        <i class="bi bi-pencil-square"></i>

                        Edit Attendance

                    </h3>

                </div>

                <div class="card-body p-4">

                    <form action="/attendance/edit/<%= attendance._id %>" method="POST">

                        <!-- Student -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">

                                Student

                            </label>

                            <select
                                class="form-select"
                                name="student"
                                required>

                                <% students.forEach(student=>{ %>

                                    <option
                                        value="<%= student._id %>"
                                        <%= attendance.student.toString() === student._id.toString() ? "selected" : "" %>>

                                        <%= student.rollNumber %> |
                                        <%= student.name %> |
                                        <%= student.course %>

                                    </option>

                                <% }) %>

                            </select>

                        </div>

                        <!-- Date -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">

                                Attendance Date

                            </label>

                            <input
                                type="date"
                                class="form-control"
                                name="date"
                                value="<%= new Date(attendance.date).toISOString().split('T')[0] %>"
                                required>

                        </div>

                        <!-- Status -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold d-block">

                                Attendance Status

                            </label>

                            <div class="form-check form-check-inline">

                                <input
                                    class="form-check-input"
                                    type="radio"
                                    name="status"
                                    value="Present"
                                    <%= attendance.status === "Present" ? "checked" : "" %>>

                                <label class="form-check-label">

                                    Present

                                </label>

                            </div>

                            <div class="form-check form-check-inline">

                                <input
                                    class="form-check-input"
                                    type="radio"
                                    name="status"
                                    value="Absent"
                                    <%= attendance.status === "Absent" ? "checked" : "" %>>

                                <label class="form-check-label">

                                    Absent

                                </label>

                            </div>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a href="/attendance" class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>

                                Back

                            </a>

                            <button class="btn btn-warning">

                                <i class="bi bi-save"></i>

                                Update Attendance

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include("../partials/footer.ejs") %>