<%- include("../partials/header.ejs") %>
<%- include("../partials/navbar.ejs") %>

<div class="container mt-5">

    <!-- Page Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                Attendance History

            </h2>

            <p class="text-muted">

                View all attendance records sorted by Date and Roll Number.

            </p>

        </div>

<div>

    <a href="/attendance/summary" class="btn btn-primary me-2">

        <i class="bi bi-bar-chart-fill"></i>

        Attendance Summary

    </a>

    <a href="/attendance/mark" class="btn btn-success">

        <i class="bi bi-calendar-check"></i>

        Mark Attendance

    </a>

</div>

    </div>

    <div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <div class="input-group">

            <select
                id="searchFilter"
                class="form-select"
                style="max-width:200px;">

                <option value="0">Date</option>
                <option value="1">Roll Number</option>
                <option value="2">Student Name</option>
                <option value="3">Course</option>
                <option value="4">Class</option>
                <option value="5">Status</option>

            </select>

            <input
                type="text"
                id="searchAttendance"
                class="form-control"
                placeholder="Search Attendance...">

            <span class="input-group-text">

                <i class="bi bi-search"></i>

            </span>

        </div>

    </div>

    </div>

    <% if(attendance.length === 0){ %>

        <div class="alert alert-info text-center">

            No attendance records available.

        </div>

    <% } else { %>

        <div class="card shadow border-0">

            <div class="card-body table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>Date</th>
                            <th>Roll No.</th>
                            <th>Student</th>
                            <th>Course</th>
                            <th>Class</th>
                            <th>Status</th>
                            <th width="170">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% attendance.forEach(record => { %>

                            <tr>

                                <td>

                                    <%= new Date(record.date).toLocaleDateString("en-GB") %>

                                </td>

                                <td>

                                    <%= record.student.rollNumber %>

                                </td>

                                <td>

                                    <%= record.student.name %>

                                </td>

                                <td>

                                    <%= record.student.course %>

                                </td>

                                <td>

                                    <%= record.student.studentClass %>

                                </td>

                                <td>

                                    <% if(record.status === "Present"){ %>

                                        <span class="badge bg-success">

                                            Present

                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-danger">

                                            Absent

                                        </span>

                                    <% } %>

                                </td>

                                <td>

                                    <a
                                        href="/attendance/edit/<%= record._id %>"
                                        class="btn btn-warning btn-sm">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <a
                                        href="/attendance/delete/<%= record._id %>"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Delete this attendance record?')">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    <% } %>

</div>

<script>

const searchInput = document.getElementById("searchAttendance");
const searchFilter = document.getElementById("searchFilter");

searchInput.addEventListener("keyup", searchAttendance);
searchFilter.addEventListener("change", searchAttendance);

function searchAttendance() {

    const value = searchInput.value.trim().toLowerCase();

    const column = Number(searchFilter.value);

    const rows = document.querySelectorAll("tbody tr");

    rows.forEach(row => {

        const text = row.cells[column].innerText.toLowerCase();

        if (text.includes(value)) {

            row.style.display = "";

        } else {

            row.style.display = "none";

        }

    });

}

</script>

<%- include("../partials/footer.ejs") %>